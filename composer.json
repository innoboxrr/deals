{
    "name": "innoboxrr/deals",
    "description": "Administrador de Deals",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Innoboxrr\\Deals\\": "src/",
            "Innoboxrr\\Deals\\Database\\Factories\\": "database/factories/"
        }
    },
    "authors": [
        {
            "name": "Homero Raul",
            "email": "h.raulvc@gmail.com"
        }
    ],
    "minimum-stability": "stable",
    "require-dev": {
        "orchestra/testbench": "^11.0",
        "innoboxrr/larapack-generator": "^7.0",
        "phpunit/phpunit": "^11.5 || ^12.0"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Innoboxrr\\Deals\\Providers\\AppServiceProvider",
                "Innoboxrr\\Deals\\Providers\\AuthServiceProvider",
                "Innoboxrr\\Deals\\Providers\\EventServiceProvider",
                "Innoboxrr\\Deals\\Providers\\RouteServiceProvider"
            ]
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Innoboxrr\\Deals\\Tests\\": "tests/"
        }
    },
    "require": {
        "innoboxrr/laravel-audit": "^2.0",
        "dragonmantank/cron-expression": "^3.4",
        "innoboxrr/support": "^2.0",
        "googleads/google-ads-php": "^33.6",
        "php": "^8.3",
        "illuminate/support": "^13.0"
    },
    "suggest": {
        "maatwebsite/excel": "Necesario para las exportaciones del paquete (^3.1)."
    }
}
